// Cloudflare Workers（静态资源模式）部署配置
// 用法：Workers & Pages → 创建 Worker → 连接 Git 仓库
//      构建设置：Build command = npm run build，Deploy command = npx wrangler deploy
// 说明：本作品为纯静态站点，整个仓库根目录就是发布目录（index.html 为入口）。
{
  "name": "cad-lab-vsim",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "none"
  }
}